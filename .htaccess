# Apache / cPanel only. GitHub Pages ignores this file.
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect www requests to the canonical HTTPS apex host.
    RewriteCond %{HTTP_HOST} ^www\.canyesilyurt\.com(?::\d+)?$ [NC]
    RewriteRule ^ https://canyesilyurt.com%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^canyesilyurt\.com(?::\d+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteRule ^ https://canyesilyurt.com%{REQUEST_URI} [R=301,L,NE]

    # Redirect direct requests, not internal DirectoryIndex lookups.
    RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
    RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    <Files "llms.txt">
        Header set X-Robots-Tag "noindex, follow"
    </Files>
    <Files "404.html">
        Header set X-Robots-Tag "noindex, follow"
    </Files>
</IfModule>
